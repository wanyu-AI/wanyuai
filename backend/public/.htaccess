# 挽屿AI API 重写规则（Apache 2.4）
<IfModule mod_rewrite.c>
    RewriteEngine On                                      # 开启重写
    RewriteCond %{HTTPS} !=on                             # 非HTTPS时
    RewriteCond %{HTTP:X-Forwarded-Proto} !https          # 且反向代理未声明HTTPS
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301] # 强制跳转HTTPS
    RewriteCond %{REQUEST_FILENAME} !-f                   # 非真实文件
    RewriteCond %{REQUEST_FILENAME} !-d                   # 非真实目录
    RewriteRule ^ index.php [L,QSA]                       # 全部交给入口
</IfModule>

# 禁止访问敏感文件
<FilesMatch "\.(sql|log|ini|env|example\.php)$">          # 匹配敏感后缀
    Require all denied                                     # 拒绝访问
</FilesMatch>

# 安全响应头
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"    # 禁止嗅探
    Header always set X-Frame-Options "DENY"              # 禁止被嵌套
    Header always set Referrer-Policy "no-referrer"       # 不泄漏来源
    Header always set Strict-Transport-Security "max-age=31536000" # HSTS
</IfModule>

# 上传大小限制
php_value post_max_size 8M                                # 请求体上限
php_value upload_max_filesize 8M                          # 上传上限
